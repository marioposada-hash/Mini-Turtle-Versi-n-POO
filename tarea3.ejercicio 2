class Tortuga:
    def __init__(self):
        self.posicion_x = 0

    def adelante(self, pasos):
        self.posicion_x += pasos
        print(f"Avanzando {pasos} → posición x = {self.posicion_x}")

    def abajo(self, pasos):
        print(f"Bajando {pasos} pasos")

    def reiniciar(self):
        self.posicion_x = 0
        print("Posición reiniciada a 0")

